// CatLog iOS 共用設定。個人或機密的值放在 Local.xcconfig（不進版控），範本見 Local.xcconfig.example。

// 對外版本號：MAJOR.MINOR 與 web 共用（見 README 的版本號規則）。
MARKETING_VERSION = 3.1.0
// Build number：CI 會以執行次數覆寫。
CURRENT_PROJECT_VERSION = 2

CATLOG_BUNDLE_ID = work.cloudjet.catlog
CATLOG_DEVELOPMENT_TEAM =
// Firebase：Debug（模擬器、開發）連測試站，Release（TestFlight、上架）連正式站。
// 兩份設定檔放在 CatLog/GoogleService-Info-Debug.plist、-Release.plist（不進版控），
// 每個建置設定只打包自己那一份，上架版本不會帶到測試站的設定。
EXCLUDED_SOURCE_FILE_NAMES[config=Debug] = GoogleService-Info-Release.plist
EXCLUDED_SOURCE_FILE_NAMES[config=Release] = GoogleService-Info-Debug.plist
GOOGLE_REVERSED_CLIENT_ID_Debug = com.googleusercontent.apps.not-configured
GOOGLE_REVERSED_CLIENT_ID_Release = com.googleusercontent.apps.not-configured

#include? "Local.xcconfig"

GOOGLE_REVERSED_CLIENT_ID = $(GOOGLE_REVERSED_CLIENT_ID_$(CONFIGURATION))
