rules_version = '2';

// 極簡貓資產：每位使用者只能讀寫自己的 users/{uid} 底下資料。
// 部署：firebase deploy --only firestore:rules
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId} {
      allow read, write: if isOwner(userId);

      // 資料塊：{ index, content, generation }
      match /chunks/{chunkId} {
        allow read, delete: if isOwner(userId);
        allow create, update: if isOwner(userId)
          && request.resource.data.keys().hasOnly(['index', 'content', 'generation'])
          && request.resource.data.index is int
          && request.resource.data.content is string
          && request.resource.data.content.size() <= 300000;
      }

      // 歷史版本：每次存檔一筆，文件 ID 為 generation；資料塊仍放在 chunks。pinned / label 為手動還原點。
      match /history/{generation} {
        allow read, delete: if isOwner(userId);
        allow create, update: if isOwner(userId)
          && request.resource.data.keys().hasOnly(['generation', 'revision', 'chunkCount', 'checksum', 'length', 'savedAt', 'deviceId', 'schemaVersion', 'pinned', 'label'])
          && request.resource.data.generation == generation
          && request.resource.data.revision is int
          && request.resource.data.chunkCount is int
          && request.resource.data.checksum is string
          && request.resource.data.length is int
          && request.resource.data.savedAt is number
          && request.resource.data.deviceId is string
          && request.resource.data.schemaVersion is int
          && (!('pinned' in request.resource.data) || request.resource.data.pinned is bool)
          && (!('label' in request.resource.data) || (request.resource.data.label is string && request.resource.data.label.size() <= 60));
      }

      // 雲端歷史的保留方式：{ mode: 'auto' | 'manual' }。
      match /settings/{docId} {
        allow read, delete: if isOwner(userId);
        allow create, update: if isOwner(userId)
          && docId == 'history'
          && request.resource.data.keys().hasOnly(['mode'])
          && request.resource.data.mode in ['auto', 'manual'];
      }

      // 指標文件：revision 只能遞增 1，避免舊版本覆蓋新版本。
      match /meta/{docId} {
        allow read: if isOwner(userId);
        allow delete: if false;
        allow create: if isOwner(userId)
          && request.resource.data.revision is int
          && request.resource.data.revision >= 1;
        allow update: if isOwner(userId)
          && request.resource.data.revision == resource.data.revision + 1;
      }
    }

    // 其他路徑一律拒絕。
    match /{document=**} {
      allow read, write: if false;
    }

    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }
  }
}
