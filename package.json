{
  "name": "catlog",
  "private": true,
  "version": "3.0.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @catlog/web",
    "build": "npm run build -w @catlog/web",
    "test": "npm run test:run --workspaces --if-present",
    "test:run": "npm run test:run --workspaces --if-present",
    "prepare": "husky install"
  },
  "devDependencies": {
    "husky": "^8.0.0"
  },
  "overrides": {
    "@grpc/grpc-js": "^1.14.7"
  }
}
